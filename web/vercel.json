{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/analyst/:path*",
      "destination": "/analyst/index.html"
    },
    {
      "source": "/analyst",
      "destination": "/analyst/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
